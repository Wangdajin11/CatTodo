[Unit]
Description=CatTodo 猫猫待办
After=network.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/cattodo.env
ExecStart=__APP_DIR__/venv/bin/python -m uvicorn backend.app:app --host __HOST__ --port __PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
